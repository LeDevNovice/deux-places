{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "unstableApiUsage": "error"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "error"
              }
            }
          },
          {
            "include": ["src/contracts/**/*.ts", "**/interface/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "unstableApiUsage": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "files": [],
  "include": ["src", "e2e", "vitest.config.ts"],
  "exclude": ["src/web"]
}
