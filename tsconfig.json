{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "unstableApiUsage": "error"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "error"
              }
            }
          },
          {
            "include": ["src/server/runtime/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "@effect/sql-sqlite-do",
                "effect/sql/Migrator",
                "effect/sql/SqlClient",
                "effect/sql/SqlError"
              ]
            }
          },
          {
            "include": [
              "src/server/modules/notifications/infrastructure/**/*.ts"
            ],
            "options": {
              "allowedUnstableApis": ["effect/sql/SqlClient"]
            }
          },
          {
            "include": [
              "src/contracts/**/*.ts",
              "src/server/interface/**/*.ts",
              "src/server/modules/*/interface/**/*.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "unstableApiUsage": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "files": [],
  "include": [
    "src",
    "e2e",
    "vitest.config.ts",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["src/web"]
}
