{
  "name": "deux-places",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && effect-tsgo patch --typescript --oxlint",
    "lint": "oxlint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --project unit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@swc/core": "1.16.22",
    "dependency-cruiser": "18.7.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "effect": "4.1.2"
  }
}
