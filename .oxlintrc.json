// oxlint rejects unknown top-level keys such as "$comment" (checked with oxlint 1.92.0), hence a JSONC comment.
// J0.5 adds the @effect/tsgo recommended preset via "extends". The agent may tighten rules, never relax them.
{
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "vitest",
    "react",
    "jsx-a11y"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "eqeqeq": "error",
    "effecttsgo/unstable-api-usage": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/expect-expect": "error",
    "complexity": [
      "error",
      10
    ],
    "max-depth": [
      "error",
      3
    ],
    "max-params": [
      "error",
      4
    ]
  },
  "overrides": [
    {
      "files": [
        "src/contracts/**",
        "**/interface/**"
      ],
      "rules": {
        "effecttsgo/unstable-api-usage": "off"
      }
    },
    {
      "files": [
        "src/server/**",
        "src/shared-kernel/**"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Date",
            "message": "Server and kernel read time through Effect Clock/DateTime only (AGENTS.md)."
          }
        ]
      }
    },
    {
      "files": [
        "scripts/**",
        "**/*.config.*",
        "e2e/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    ".wrangler",
    "node_modules",
    "docs/specs"
  ]
}
