{
  "name": "deux-places",
  "main": "src/server/worker.ts",
  // Latest date supported by the installed workerd (1.20261103.1); do not go past it.
  "compatibility_date": "2026-11-03",
  "assets": {
    // Unknown paths serve index.html; the PWA router resolves them.
    "not_found_handling": "single-page-application",
    // Every request but the hashed bundles reaches the Worker first, so that pages and API
    // responses carry the security headers (technique-v2 §13.3); it serves pages through ASSETS.
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  // Exported by the main module; always reached through `jurisdiction("eu")` (technique-v2 §10.1).
  "durable_objects": {
    "bindings": [
      { "name": "Household", "class_name": "Household" },
      { "name": "Directory", "class_name": "Directory" },
    ],
  },
  // Workers Logs (technique-v2 §12.1): the JSON lines and one invocation log per request, alarm or
  // RPC, which carries its CPU time (`$workers.cpuTimeMs`, read at J1.19). The docs require this
  // setting in the Wrangler file; every request is logged (default sampling rate 1).
  "observability": { "enabled": true },
  // One environment and one origin (§10.4, ADR-017): no version or preview URLs on workers.dev.
  "preview_urls": false,
  // Forward-only: never edit an applied migration, append a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Household", "Directory"] },
  ],
}
